{
  "compilerOptions": {
    "target": "esnext",
    "module": "esnext",
    "lib": ["dom", "esnext"],
    "declaration": true,
    "sourceMap": true,
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "strict": true,
    "noImplicitAny": true,
    "isolatedModules": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "declarationMap": true,
    "types": ["node"],
    // tsup 6 sets the deprecated baseUrl option when it builds the declaration files.
    "ignoreDeprecations": "6.0"
  },
  "include": ["packages", ".eslintrc.js", "tsup.config.ts", "vitest.config.mts"],
  "exclude": ["**/node_modules"]
}
