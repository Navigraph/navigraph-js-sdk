{
  "$schema": "https://turborepo.org/schema.json",
  "pipeline": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "*/dist/**"]
    },
    "dev": { "cache": false },
    "clean": { "cache": false },
    "prepack": { "cache": false },
    "postpack": { "cache": false }
  },
  "globalDependencies": ["tsconfig.json", "tsdown.config.mts", "patches/**"]
}
