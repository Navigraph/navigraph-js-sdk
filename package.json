{
  "name": "sdk",
  "private": true,
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "build": "turbo run build --filter='./packages/*'",
    "dev": "turbo run dev --filter='./packages/*' --no-cache --continue --parallel",
    "clean": "turbo run clean --filter='./packages/*'",
    "lint": "turbo run lint --parallel --continue --filter='./packages/*' -- --max-warnings=0",
    "lint:fix": "bun run lint --parallel --filter='./packages/*' -- --fix",
    "prepack": "turbo run prepack --filter='./packages/*'",
    "postpack": "turbo run postpack --filter='./packages/*'",
    "test": "vitest run",
    "release": "changeset publish",
    "version": "changeset version && bun install --lockfile-only"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@ianvs/prettier-plugin-sort-imports": "^4.1.0",
    "@swc/core": "^1.3.11",
    "@types/node": "^24.19.2",
    "@typescript-eslint/eslint-plugin": "^6.4.0",
    "@typescript-eslint/parser": "^6.4.0",
    "clean-package": "^2.1.2",
    "cross-env": "^7.0.3",
    "eslint": "^8.47.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "finally-polyfill": "^0.2.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.0.2",
    "rimraf": "^3.0.2",
    "tsup": "^6.3.0",
    "turbo": "^1.10.12",
    "typescript": "^5.0.4",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  },
  "patchedDependencies": {
    "axios@0.24.0": "patches/axios@0.24.0.patch",
    "metar-taf-parser@8.0.5": "patches/metar-taf-parser@8.0.5.patch"
  },
  "packageManager": "bun@1.4.4"
}
