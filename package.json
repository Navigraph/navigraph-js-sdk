{
  "name": "sdk",
  "private": true,
  "workspaces": {
    "packages": [
      "packages/*",
      "examples/*"
    ],
    "catalog": {
      "@vitejs/plugin-react": "^6.2.1",
      "vite": "^8.3.5",
      "typescript": "^6.0.3"
    }
  },
  "scripts": {
    "build": "bun run --filter './packages/*' build",
    "dev": "bun run --filter './packages/*' --parallel --no-exit-on-error dev",
    "clean": "bun run --filter './packages/*' clean",
    "lint": "oxlint && prettier --check \"{packages,examples}/*/src/**/*.{ts,tsx}\"",
    "lint:fix": "oxlint --fix && prettier --write \"{packages,examples}/*/src/**/*.{ts,tsx}\"",
    "prepack": "bun run --filter './packages/*' prepack",
    "postpack": "bun run --filter './packages/*' postpack",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && bun run --filter './examples/*' typecheck",
    "release": "changeset publish",
    "version": "changeset version && bun install --lockfile-only"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@ianvs/prettier-plugin-sort-imports": "^4.1.0",
    "@types/node": "^24.19.2",
    "clean-package": "^2.1.2",
    "finally-polyfill": "^0.2.0",
    "jsdom": "^30.1.3",
    "oxlint": "^1.90.0",
    "oxlint-tsgolint": "^7.0.2005",
    "prettier": "^3.0.2",
    "rimraf": "^6.1.3",
    "tsdown": "0.23.4",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "^5.1.0"
  },
  "patchedDependencies": {
    "axios@0.24.0": "patches/axios@0.24.0.patch"
  },
  "packageManager": "bun@1.4.4"
}
