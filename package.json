{
  "name": "sdk",
  "private": true,
  "workspaces": {
    "packages": [
      "packages/*",
      "examples/*"
    ],
    "catalog": {
      "@vitejs/plugin-react": "^6.2.1",
      "vite": "^8.3.5",
      "typescript": "^6.0.3"
    }
  },
  "scripts": {
    "build": "turbo run build --filter='./packages/*'",
    "dev": "turbo run dev --filter='./packages/*' --no-cache --continue --parallel",
    "clean": "turbo run clean --filter='./packages/*'",
    "lint": "oxlint && prettier --check \"{packages,examples}/*/src/**/*.{ts,tsx}\"",
    "lint:fix": "oxlint --fix && prettier --write \"{packages,examples}/*/src/**/*.{ts,tsx}\"",
    "prepack": "turbo run prepack --filter='./packages/*'",
    "postpack": "turbo run postpack --filter='./packages/*'",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && bun run --filter './examples/*' typecheck",
    "release": "changeset publish",
    "version": "changeset version && bun install --lockfile-only"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@ianvs/prettier-plugin-sort-imports": "^4.1.0",
    "@swc/core": "^1.3.11",
    "@types/node": "^24.19.2",
    "clean-package": "^2.1.2",
    "cross-env": "^7.0.3",
    "finally-polyfill": "^0.2.0",
    "jsdom": "^30.1.3",
    "oxlint": "^1.90.0",
    "oxlint-tsgolint": "^7.0.2005",
    "prettier": "^3.0.2",
    "rimraf": "^3.0.2",
    "tsup": "^6.3.0",
    "turbo": "^1.10.12",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "^5.1.0"
  },
  "patchedDependencies": {
    "axios@0.24.0": "patches/axios@0.24.0.patch",
    "metar-taf-parser@8.0.5": "patches/metar-taf-parser@8.0.5.patch"
  },
  "packageManager": "bun@1.4.4"
}
